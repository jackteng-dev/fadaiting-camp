# Compose 啟動前填入本機產生的私有隨機金鑰，至少 32 字元。
# 本機直接啟動 Java 時，另行設定 JWT_SECRET 環境變數。
JWT_SECRET=

# 僅用新 SeaweedFS scope；不掛入或刪除舊 MinIO volume。
# 先產生私有金鑰，再執行 scripts/configure-camp-storage.py。
CAMP_STORAGE_ACCESS_KEY=
CAMP_STORAGE_SECRET_KEY=
CAMP_STORAGE_CONFIG_FILE=
CAMP_STORAGE_ENDPOINT=http://localhost:9000
CAMP_STORAGE_REGION=us-east-1
CAMP_STORAGE_PUBLIC_BASE_PATH=/objects

# 新預約付款期限與批次；既有 DB 先補 005 SQL
BOOKING_HOLD_MINUTES=30
BOOKING_HOLD_ENABLED=true
BOOKING_HOLD_BATCH_SIZE=100
BOOKING_HOLD_SWEEP_DELAY_MS=60000

# 正式 HTTPS 使用 true；僅本機 HTTP 開發時改 false。
AUTH_COOKIE_SECURE=true
# LINE Login Channel ID（不是 Messaging API Channel ID）；未設定時 LINE 查單關閉。
LINE_IDENTITY_ENABLED=false
LINE_LOGIN_CHANNEL_ID=

# 008 通知佇列：預設停用真實寄信與自動 worker；後台仍可免費模擬。
NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_DELIVERY_MODE=disabled
NOTIFICATION_BATCH_SIZE=20
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_SECONDS=60
NOTIFICATION_RETRY_MAX_SECONDS=3600
NOTIFICATION_LEASE_SECONDS=120
NOTIFICATION_OVERDUE_THRESHOLD_SECONDS=900
# 僅唯讀試算門檻，非核定保留政策；不啟用刪除。
NOTIFICATION_RETENTION_PREVIEW_DAYS=180

# 備份觀測預設未設定；container 內路徑需搭配唯讀掛載 overlay。
BACKUP_MONITOR_JOURNAL_PATH=
BACKUP_MONITOR_SOURCE_KEY=primary
BACKUP_MONITOR_MAX_BACKUP_AGE_SECONDS=86400
BACKUP_MONITOR_MAX_RESTORE_AGE_SECONDS=604800
BACKUP_MONITOR_RUN_TIMEOUT_SECONDS=3600
BACKUP_MONITOR_RECORD_LIMIT=2000
BACKUP_MONITOR_JOURNAL_HOST_PATH=
NOTIFICATION_SWEEP_DELAY_MS=30000
# 真實 SMTP 留待實際帳號驗收，勿提交帳密。
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
NOTIFICATION_MAIL_FROM_ADDRESS=
NOTIFICATION_MAIL_FROM_NAME=發呆亭露營區
